<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DesktopAssistant.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="32,24" Spacing="24" MaxWidth="700">

            <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" />

            <!-- User Info Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="12" Padding="24">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{ThemeResource AccentAAFillColorDefaultBrush}" 
                            CornerRadius="30" Width="60" Height="60">
                        <FontIcon Glyph="&#xE77B;" FontSize="28" Foreground="White"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.UserName, Mode=OneWay}" 
                                   FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.UserEmail, Mode=OneWay}" 
                                   FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Server Configuration -->
            <StackPanel Spacing="12">
                <TextBlock Text="Server Configuration" FontSize="18" FontWeight="SemiBold" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        CornerRadius="12" Padding="24">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="API Base URL" FontSize="13" FontWeight="SemiBold" />
                            <TextBox Text="{x:Bind ViewModel.ApiBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="https://api.example.com"
                                     CornerRadius="8" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="WebSocket URL" FontSize="13" FontWeight="SemiBold" />
                            <TextBox Text="{x:Bind ViewModel.WsBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="wss://api.example.com/ws"
                                     CornerRadius="8" />
                        </StackPanel>

                        <Button Content="Save Configuration"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="20,10" CornerRadius="8"
                                Command="{x:Bind ViewModel.SaveSettingsCommand}" />

                        <InfoBar x:Name="StatusInfoBar"
                                 IsOpen="False"
                                 Severity="Success"
                                 Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Actions -->
            <StackPanel Spacing="12">
                <TextBlock Text="Account" FontSize="18" FontWeight="SemiBold" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        CornerRadius="12" Padding="24">
                    <StackPanel Spacing="12">
                        <Button Content="Reset Tutorial" 
                                Padding="20,10" CornerRadius="8"
                                Command="{x:Bind ViewModel.ResetTutorialCommand}" />

                        <Button Content="Sign Out" 
                                Padding="20,10" CornerRadius="8"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Command="{x:Bind ViewModel.LogoutCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- About -->
            <StackPanel Spacing="12">
                <TextBlock Text="About" FontSize="18" FontWeight="SemiBold" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        CornerRadius="12" Padding="24">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Desktop Assistant" FontWeight="SemiBold" />
                        <TextBlock Text="Version 1.0.0" FontSize="13" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Built with WinUI 3 &amp; Windows App SDK" FontSize="13" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
