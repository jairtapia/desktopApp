<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DesktopAssistant.Views.DevPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Pivot>

        <!-- ── Tab 1: WebSocket Monitor ── -->
        <PivotItem Header="WebSocket Monitor">
            <Grid Padding="0,16,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Simulate NLP" Command="{x:Bind ViewModel.SimulateNLPCommand}" CornerRadius="6" Width="130" />
                        <Button Content="Clear Logs" Command="{x:Bind ViewModel.ClearLogsCommand}" CornerRadius="6" Width="100" />
                    </StackPanel>

                    <TextBlock Text="App Focus (Mobile Sync)" FontSize="13" FontWeight="SemiBold"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                        <Button Content="Chrome"   Command="{x:Bind ViewModel.SimulateFocusBrowserCommand}"  CornerRadius="6" Style="{StaticResource AccentButtonStyle}" Width="84" />
                        <Button Content="Word"     Command="{x:Bind ViewModel.SimulateFocusWordCommand}"     CornerRadius="6" Style="{StaticResource AccentButtonStyle}" Width="84" />
                        <Button Content="Excel"    Command="{x:Bind ViewModel.SimulateFocusExcelCommand}"    CornerRadius="6" Style="{StaticResource AccentButtonStyle}" Width="84" />
                        <Button Content="Spotify"  Command="{x:Bind ViewModel.SimulateFocusSpotifyCommand}"  CornerRadius="6" Style="{StaticResource AccentButtonStyle}" Width="84" />
                        <Button Content="Explorer" Command="{x:Bind ViewModel.SimulateFocusExplorerCommand}" CornerRadius="6" Style="{StaticResource AccentButtonStyle}" Width="84" />
                        <Button Content="System"   Command="{x:Bind ViewModel.SimulateFocusSystemCommand}"   CornerRadius="6" Style="{StaticResource AccentButtonStyle}" Width="84" />
                        <Button Content="X-Tools"  Command="{x:Bind ViewModel.SimulateFocusXToolsCommand}"   CornerRadius="6" Style="{StaticResource AccentButtonStyle}" Width="84" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" BorderThickness="1"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <ListView ItemsSource="{x:Bind ViewModel.Logs, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="13" Padding="8,4" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>
        </PivotItem>

        <!-- ── Tab 2: Active App Monitor ── -->
        <PivotItem Header="Active App">
            <Grid Padding="0,16,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Current active app card -->
                <Border Grid.Row="0" Margin="0,0,0,16" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" BorderThickness="1"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="APP ACTIVA AHORA" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ActiveAppName, Mode=OneWay}"
                                       FontSize="22" FontWeight="Bold" />
                            <TextBlock Text="{x:Bind ViewModel.ActiveAppTitle, Mode=OneWay}"
                                       FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="PID" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.ActiveAppPid, Mode=OneWay}"
                                               FontFamily="Consolas" FontSize="12" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="PATH" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.ActiveAppPath, Mode=OneWay}"
                                               FontFamily="Consolas" FontSize="11"
                                               TextTrimming="CharacterEllipsis" MaxWidth="500" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1" Content="Limpiar historial"
                                Command="{x:Bind ViewModel.ClearAppHistoryCommand}"
                                CornerRadius="6" VerticalAlignment="Top" />
                    </Grid>
                </Border>

                <!-- History list -->
                <Border Grid.Row="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" BorderThickness="1"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="HISTORIAL DE CAMBIOS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="12,10,0,6" />
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.AppHistory, Mode=OneWay}"
                                  SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Padding="4,2" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </PivotItem>

        <!-- ── Tab 3: Sync JSON Viewer ── -->

        <PivotItem Header="Sync JSON">
            <Grid Padding="0,16,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
                    <Button Content="Escanear" Command="{x:Bind ViewModel.RunScanCommand}"
                            CornerRadius="6" Style="{StaticResource AccentButtonStyle}" Width="110"
                            IsEnabled="{x:Bind ViewModel.IsNotScanning, Mode=OneWay}" />
                    <Button Content="Copiar JSON" Command="{x:Bind ViewModel.CopyJsonCommand}"
                            CornerRadius="6" Width="110"
                            IsEnabled="{x:Bind ViewModel.HasJson, Mode=OneWay}" />
                    <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Width="22" Height="22" />
                    <TextBlock Text="{x:Bind ViewModel.ScanStatus, Mode=OneWay}"
                               VerticalAlignment="Center" FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Border Grid.Row="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" BorderThickness="1"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Padding="16">
                        <TextBlock Text="{x:Bind ViewModel.ScanJson, Mode=OneWay}"
                                   FontFamily="Consolas" FontSize="12"
                                   TextWrapping="NoWrap"
                                   IsTextSelectionEnabled="True" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </PivotItem>

    </Pivot>
</Page>
