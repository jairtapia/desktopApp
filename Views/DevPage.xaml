<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DesktopAssistant.Views.DevPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24" Spacing="16">
            <TextBlock Text="WebSocket Monitor" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="Simulations" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Simulate NLP" Command="{x:Bind ViewModel.SimulateNLPCommand}" CornerRadius="8" Width="140" />
                <Button Content="Clear Logs" Command="{x:Bind ViewModel.ClearLogsCommand}" CornerRadius="8" Width="140" />
            </StackPanel>

            <TextBlock Text="App Focus (Mobile Sync)" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Chrome" Command="{x:Bind ViewModel.SimulateFocusBrowserCommand}" CornerRadius="8" Style="{StaticResource AccentButtonStyle}" Width="90" />
                <Button Content="Word" Command="{x:Bind ViewModel.SimulateFocusWordCommand}" CornerRadius="8" Style="{StaticResource AccentButtonStyle}" Width="90" />
                <Button Content="Excel" Command="{x:Bind ViewModel.SimulateFocusExcelCommand}" CornerRadius="8" Style="{StaticResource AccentButtonStyle}" Width="90" />
                <Button Content="Spotify" Command="{x:Bind ViewModel.SimulateFocusSpotifyCommand}" CornerRadius="8" Style="{StaticResource AccentButtonStyle}" Width="90" />
                <Button Content="Explorer" Command="{x:Bind ViewModel.SimulateFocusExplorerCommand}" CornerRadius="8" Style="{StaticResource AccentButtonStyle}" Width="90" />
                <Button Content="System" Command="{x:Bind ViewModel.SimulateFocusSystemCommand}" CornerRadius="8" Style="{StaticResource AccentButtonStyle}" Width="90" />
                <Button Content="X-Tools" Command="{x:Bind ViewModel.SimulateFocusXToolsCommand}" CornerRadius="8" Style="{StaticResource AccentButtonStyle}" Width="100" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <ListView ItemsSource="{x:Bind ViewModel.Logs, Mode=OneWay}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="13" Padding="8,4" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
