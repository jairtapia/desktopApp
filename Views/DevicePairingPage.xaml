<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DesktopAssistant.Views.DevicePairingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:DesktopAssistant.Converters"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <ScrollViewer>
        <Grid Padding="32,24" MaxWidth="800" HorizontalAlignment="Center">
            <StackPanel Spacing="24">
                
                <!-- Header -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Device Pairing" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="Link your mobile device to control this computer remotely"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="15" />
                </StackPanel>

                <!-- Main Content -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Instructions -->
                    <StackPanel Grid.Column="0" Spacing="16" Margin="0,0,32,0">
                        <TextBlock Text="How to pair" FontSize="18" FontWeight="SemiBold" />

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                CornerRadius="12" Padding="20">
                            <StackPanel Spacing="16">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{ThemeResource AccentAAFillColorDefaultBrush}" 
                                            CornerRadius="20" Width="32" Height="32">
                                        <TextBlock Text="1" Foreground="White" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Generate QR Code" FontWeight="SemiBold" />
                                        <TextBlock Text="Click the button below to create a new pairing QR code" 
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{ThemeResource AccentAAFillColorDefaultBrush}" 
                                            CornerRadius="20" Width="32" Height="32">
                                        <TextBlock Text="2" Foreground="White" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Open Mobile App" FontWeight="SemiBold" />
                                        <TextBlock Text="Open the Desktop Assistant app on your phone" 
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{ThemeResource AccentAAFillColorDefaultBrush}" 
                                            CornerRadius="20" Width="32" Height="32">
                                        <TextBlock Text="3" Foreground="White" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Scan QR Code" FontWeight="SemiBold" />
                                        <TextBlock Text="Use your phone's camera to scan the QR code displayed here" 
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Device Info -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                CornerRadius="12" Padding="20">
                            <StackPanel Spacing="8">
                                <TextBlock Text="This Device" FontWeight="SemiBold" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" FontSize="13" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,16,4" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.DeviceName, Mode=OneWay}" 
                                               FontSize="13" FontWeight="SemiBold" />
                                    
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Local IP:" FontSize="13" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,16,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.LocalIp, Mode=OneWay}" 
                                               FontSize="13" FontWeight="SemiBold" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right: QR Code -->
                    <StackPanel Grid.Column="1" Spacing="16" Width="280">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                CornerRadius="16" Padding="24">
                            <StackPanel Spacing="16" HorizontalAlignment="Center">
                                <TextBlock Text="QR Code" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                
                                <Border Background="White" CornerRadius="12" Padding="12">
                                    <Image x:Name="QrCodeImage" Width="200" Height="200" Stretch="Uniform" />
                                </Border>

                                <!-- Pair Code Display -->
                                <StackPanel Spacing="4" HorizontalAlignment="Center"
                                            Visibility="{x:Bind ViewModel.IsWaitingForDevice, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Pair Code" FontSize="12" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.PairCode, Mode=OneWay}" 
                                               FontSize="28" FontWeight="Bold" 
                                               HorizontalAlignment="Center"
                                               CharacterSpacing="200" />
                                </StackPanel>

                                <Button Content="Generate QR Code"
                                        Style="{StaticResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Padding="0,12" CornerRadius="8"
                                        Command="{x:Bind ViewModel.GenerateQrCodeCommand}" />

                                <Button Content="Refresh"
                                        HorizontalAlignment="Stretch"
                                        Padding="0,10" CornerRadius="8"
                                        Visibility="{x:Bind ViewModel.IsWaitingForDevice, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                        Command="{x:Bind ViewModel.RefreshQrCodeCommand}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                                   FontSize="12" TextAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
