<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DesktopAssistant.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:DesktopAssistant.Converters"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="32,24" Spacing="24" HorizontalAlignment="Left">

            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock FontSize="28" FontWeight="Bold">
                        <Run Text="Hello, " />
                        <Run Text="{x:Bind ViewModel.UserName, Mode=OneWay}" />
                        <Run Text=" 👋" />
                    </TextBlock>
                    <TextBlock Text="Here's your desktop control center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="15" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.SyncNowCommand}" CornerRadius="8" Padding="12,8"
                            Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Sync State" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.RefreshAppsCommand}" CornerRadius="8" Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.NavigateToSyncCommand}" CornerRadius="8" Padding="12,8"
                            Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE836;" FontSize="14" />
                            <TextBlock Text="Sync Device" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Status Cards -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Connection Status -->
                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        CornerRadius="12" Padding="20" Margin="0,0,8,0">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Connection" FontSize="13" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Ellipse Grid.Column="1" Width="10" Height="10" 
                                     Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" 
                                   FontSize="20" FontWeight="SemiBold" />
                        <Button Content="{x:Bind ViewModel.IsConnected, Mode=OneWay}" 
                                Visibility="Collapsed" />
                        <HyperlinkButton Content="Toggle Connection"
                                         Command="{x:Bind ViewModel.ConnectWebSocketCommand}"
                                         Padding="0" FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- Installed Apps -->
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        CornerRadius="12" Padding="20" Margin="4,0">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Installed Apps" FontSize="13" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.InstalledAppsCount, Mode=OneWay}" 
                                   FontSize="28" FontWeight="Bold" />
                        <FontIcon Glyph="&#xE71D;" FontSize="20" 
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}" 
                                  HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- Running Apps -->
                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        CornerRadius="12" Padding="20" Margin="4,0">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Running Apps" FontSize="13" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.RunningAppsCount, Mode=OneWay}" 
                                   FontSize="28" FontWeight="Bold" />
                        <FontIcon Glyph="&#xE768;" FontSize="20" 
                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}" 
                                  HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- Commands Executed -->
                <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        CornerRadius="12" Padding="20" Margin="8,0,0,0">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Commands" FontSize="13" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.CommandsExecuted, Mode=OneWay}" 
                                   FontSize="28" FontWeight="Bold" />
                        <FontIcon Glyph="&#xE943;" FontSize="20" 
                                  Foreground="{ThemeResource SystemFillColorCautionBrush}" 
                                  HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Running Applications List -->
            <StackPanel Spacing="12">
                <TextBlock Text="Running Applications" FontSize="18" FontWeight="SemiBold" />

                <ProgressBar IsIndeterminate="True"
                             Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                <ListView ItemsSource="{x:Bind ViewModel.RunningApps, Mode=OneWay}"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,12" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="{ThemeResource AccentAAFillColorDefaultBrush}" 
                                        CornerRadius="8" Width="36" Height="36">
                                    <FontIcon Glyph="&#xE737;" FontSize="16" Foreground="White"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding WindowTitle}" FontWeight="SemiBold" 
                                               TextTrimming="CharacterEllipsis" MaxWidth="300" />
                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="PID: " />
                                    <Run Text="{Binding ProcessId}" />
                                </TextBlock>

                                <Border Grid.Column="3" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" 
                                        CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="Running" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
